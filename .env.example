# Contact form delivery (Resend). Copy to .env.local for development and set the same
# variables in your hosting provider's environment settings for production.

# Required. Create at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Where enquiries are delivered; defaults to the address in src/data/site.ts.
CONTACT_TO_EMAIL=

# Optional. Sender shown on the email. Without a verified domain on Resend, leave this unset
# to use their onboarding sender (delivers only to your own Resend account email).
# With a verified domain: CONTACT_FROM_EMAIL="Portfolio <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=
